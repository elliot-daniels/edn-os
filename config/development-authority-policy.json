{
  "policy_id": "edn-development-standing-authority",
  "version": "1.0.0",
  "allowed_actions": [
    "agent.local.execute",
    "architecture.approved.refactor",
    "audit.development.write",
    "code.development.write",
    "config.development.write",
    "documentation.write",
    "git.branch.create",
    "git.commit.prepare",
    "git.history.read",
    "git.status.read",
    "repository.read",
    "roadmap.continue",
    "state.development.write",
    "synthetic.fixture.write",
    "test.development.write",
    "validation.mypy",
    "validation.pytest",
    "validation.ruff",
    "validation.static",
    "validation.whitespace"
  ],
  "owner_required_actions": [
    "architecture.material_change",
    "authentication.interactive",
    "authority.indeterminate",
    "data.new_access",
    "destructive.operation",
    "external.communication",
    "external.permission.new",
    "financial.transaction",
    "git.protected.merge",
    "human_authority.change",
    "infrastructure.material_cost",
    "legal.commitment",
    "migration.irreversible",
    "production.data.delete",
    "production.mutation",
    "product.vision.change",
    "purchase",
    "security.scope.expand",
    "security.weaken"
  ],
  "prohibited_actions": [
    "autonomous.external.communication",
    "autonomous.financial.action",
    "autonomous.production.deployment",
    "cloud.orchestrator.create",
    "production.protected_branch.force",
    "security.control.bypass"
  ]
}
